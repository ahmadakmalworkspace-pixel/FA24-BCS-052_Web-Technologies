<main class="container mt-4">
  <a href="/">← back to store</a>

  <div class="product-layout mt-3">

    <div class="product-image">
      <img src="/images/<%= product.image %>" class="big-img" alt="<%= product.name %>">
    </div>

    <div class="product-details">
      <h1><%= product.name %></h1>
      <p class="price fs-3">Rs. <%= product.price %></p>
      <div class="mb-3">
        <label for="qty" class="form-label">Quantity</label>
        <input type="number" id="qty" class="form-control w-25" value="1" min="1">
      </div>
      <button class="btn btn-warning btn-lg">Add to Cart</button>
    </div>

    <div class="product-description">
      <h2 class="fs-5">Description</h2>
      <% product.description.forEach(function (paragraph) { %>
        <p><%= paragraph %></p>
      <% }); %>
      <h2 class="fs-5">Details</h2>
      <ul>
        <% product.details.forEach(function (item) { %>
          <li><%= item %></li>
        <% }); %>
      </ul>
    </div>

  </div>
</main>
